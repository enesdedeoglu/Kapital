    "test": "vitest run",
    "run": "tsx src/cli/run-ticks.ts",
    "shock": "tsx src/cli/scenario-shock.ts"
  },
  "dependencies": {
    "@kapital/config": "workspace:*",
    "@kapital/db": "workspace:*",
    "@kapital/economy": "workspace:*",
    "@kapital/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
